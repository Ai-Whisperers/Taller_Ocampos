# Deployment Environment Configuration for Taller Ocampos
# Copy this to project root as .env and configure for your deployment

# ==========================================
# Database Configuration
# ==========================================
POSTGRES_USER=taller_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=taller_mecanico
POSTGRES_PORT=5432

# ==========================================
# Backend Configuration
# ==========================================
NODE_ENV=production
PORT=3001
BACKEND_PORT=3001
SOCKET_PORT=3002

# JWT Configuration - MUST CHANGE FOR PRODUCTION
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Database Connection (auto-constructed from above)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ==========================================
# Frontend Configuration - Cloudflared URLs
# ==========================================
# These URLs match your cloudflared tunnel configuration
NEXT_PUBLIC_API_URL=https://api.taller-ocampos.ai-whisperers.org/api
NEXT_PUBLIC_SOCKET_URL=https://ws.taller-ocampos.ai-whisperers.org
NEXT_PUBLIC_APP_NAME=Taller Mecánico
NEXT_PUBLIC_APP_URL=https://taller-ocampos.ai-whisperers.org

# CORS Configuration - CRITICAL FOR SECURITY
FRONTEND_URL=https://taller-ocampos.ai-whisperers.org
MOBILE_URL=

# ==========================================
# File Upload Configuration
# ==========================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=info

# ==========================================
# PgAdmin Configuration (Optional)
# ==========================================
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD

# ==========================================
# Production Deployment Notes
# ==========================================
# 1. Change all passwords and secrets marked with CHANGE_ME
# 2. JWT_SECRET should be at least 32 random characters
# 3. FRONTEND_URL must match your cloudflared tunnel hostname
# 4. Database passwords should be strong (16+ characters)
# 5. Never commit this file with real credentials
# 6. Use cloudflared tunnel for secure public access
